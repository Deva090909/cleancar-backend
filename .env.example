# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/cleancar_erp?schema=public"

# ── Redis (BullMQ) ────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-secret-min-32-chars"
JWT_REFRESH_SECRET="another-long-random-secret-for-refresh-tokens"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URLS="http://localhost:5173,https://cleancar-v13-deploy-amit.vercel.app"

# ── Auth policy ───────────────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=30
OTP_EXPIRY_MINUTES=10
